# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Encryption for SMTP passwords (32+ chars). Optional: SESSION_SECRET is used as fallback if 32+ chars
ENCRYPTION_KEY=genera-un-string-aleatorio-de-al-menos-32-caracteres

# Panel authentication
PANEL_PASSWORD=tu-contrasena-segura
SESSION_SECRET=genera-un-string-aleatorio-de-al-menos-32-caracteres

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
